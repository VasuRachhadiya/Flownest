{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=FlownestDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "Flownest",
    "Audience": "Flownest.Clients",
    "SecretKey": "",
    "ExpirationMinutes": 480
